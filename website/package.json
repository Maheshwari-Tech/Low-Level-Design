{
  "name": "lld-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:refresh": "node scripts/generate-content.mjs",
    "dev": "node scripts/generate-content.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev -p 4105",
    "dev:next": "node scripts/generate-content.mjs && next dev -p 4105",
    "dev:zone": "node scripts/generate-content.mjs && LLD_BASE_PATH=/candidate/learn/lld NEXT_PUBLIC_LLD_BASE_PATH=/candidate/learn/lld LLD_ASSET_PREFIX=/lld-static next dev -p 4105",
    "build": "node scripts/generate-content.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:zone": "node scripts/generate-content.mjs && LLD_BASE_PATH=/candidate/learn/lld NEXT_PUBLIC_LLD_BASE_PATH=/candidate/learn/lld LLD_ASSET_PREFIX=/lld-static next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start -p 4105",
    "test": "pnpm build && node --test tests/rendered-html.test.mjs",
    "test:microfrontends": "node --test tests/microfrontend-zone.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
